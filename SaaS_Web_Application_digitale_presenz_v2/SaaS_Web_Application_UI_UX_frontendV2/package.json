{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && pnpm run build:ssr && node scripts/generate-nginx-locale-map.mjs && node scripts/prerender.mjs && node scripts/check-seo-build.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "check:seo": "node scripts/check-seo-build.mjs",
    "check:nginx": "bash scripts/verify-nginx.sh",
    "assets": "python3 scripts/generate_brand_assets.py",
    "snapshot:blog": "node scripts/fetch-wordpress-snapshot.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "format": "oxfmt"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
