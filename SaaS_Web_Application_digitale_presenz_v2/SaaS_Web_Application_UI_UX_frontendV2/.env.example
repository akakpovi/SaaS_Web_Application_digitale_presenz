[TEMPLATE]
# Base de l'API Django. Vide = same-origin (/api/v1), le cas du build Docker.
VITE_API_BASE_URL=/api/v1

# CMS WordPress headless (API REST). Doit être une URL absolue en production,
# par exemple https://cms.example.com. En local, nginx proxifie /cms vers
# l'instance WordPress de docker compose. Sans cette variable, le blog affiche
# une erreur explicite : aucun article de démonstration n'est servi.
VITE_WP_API_URL=/cms

# Origine publique (canonical, sitemap, robots.txt). Injectée au build.
VITE_BASE_URL=https://localhost

# --- Analytics (inactif par défaut) -------------------------------------
# Aucun script de mesure n'est chargé tant que VITE_ANALYTICS_ENABLED n'est pas
# exactement "true" au moment du build. L'activation publique reste bloquée
# jusqu'à la finalisation des pages Datenschutz/Cookies : voir
# docs/audits/PRESENCE_ANALYTICS_PLAN_2026-10-28.md (porte juridique).
# Pour une vérification locale uniquement, poser "true" dans `.env.local`
# (fichier non versionné), jamais dans ce gabarit ni dans une config de prod.
VITE_ANALYTICS_ENABLED=false
# Identifiant du site dans l'instance Umami ("data-website-id").
VITE_ANALYTICS_WEBSITE_ID=
# Chemin same-origin du script, proxifié par nginx vers l'instance Umami.
VITE_ANALYTICS_SCRIPT_URL=/stats/script.js
