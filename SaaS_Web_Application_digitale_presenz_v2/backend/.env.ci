# CI-only environment for the E2E Docker Compose stack.
# Every value is a non-production placeholder. Never use this file for a real
# deployment and never replace these values with production credentials.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=ci-only-not-a-production-secret
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://localhost
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://localhost

POSTGRES_DB=presence
POSTGRES_USER=presence
POSTGRES_PASSWORD=presence-ci-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Public 32-byte test KEK required by integrations.E001.
# This is a deterministic test value, not a production key.
CONNECTOR_KEK_V1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CONNECTOR_KEK_ACTIVE_VERSION=1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@presence.local
SERVER_EMAIL=noreply@presence.local

BILLING_ENABLED=false
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox

AI_ADVISOR_ENABLED=false
AKA_AI_API_KEY=
SCANNER_ADVANCED_SECURITY_ENABLED=false
