[TEMPLATE]
# --- Social connector token vault (AES-256-GCM envelope encryption) ------
# Generate a 32-byte key with: openssl rand -base64 32
# The application refuses to start when CONNECTOR_KEK_V1 is missing or does
# not decode to exactly 32 bytes.  Keep old versions (V1, V2, ...) available
# while a rotation is in progress; set CONNECTOR_KEK_ACTIVE_VERSION to the
# version used for newly wrapped DEKs.
CONNECTOR_KEK_V1=
CONNECTOR_KEK_ACTIVE_VERSION=1

# --- LinkedIn OAuth --------------------------------------------------------
# Créer l'application dans le portail LinkedIn et enregistrer EXACTEMENT
# l'URL de redirection ci-dessous.  Le secret reste strictement serveur.
# Sans client_id, l'endpoint authorize renvoie 503 sans fabriquer d'URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://localhost/api/v1/social/oauth/linkedin/callback/
LINKEDIN_OAUTH_REVOKE_URL=https://www.linkedin.com/oauth/v2/revoke
LINKEDIN_OAUTH_SCOPES=openid profile w_member_social
LINKEDIN_OAUTH_TIMEOUT=10
# Scheduled refresh: look 72h ahead, at most 200 connections per run.
SOCIAL_TOKEN_REFRESH_WINDOW_HOURS=72
SOCIAL_TOKEN_REFRESH_BATCH_SIZE=200
# Consecutive provider failures before parking a connection in ERROR.
SOCIAL_TOKEN_REFRESH_MAX_FAILURES=3
# Durée de vie du state OAuth (secondes).  Court par conception.
OAUTH_STATE_TTL_SECONDS=600

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LOG_LEVEL=INFO
# Origine de l'application React.  Le callback OAuth redirige vers cette URL
# avec ?integration=linkedin&status=success, ou ?integration=linkedin&error=auth_failed.
FRONTEND_URL=https://localhost
# Origine utilisée par Paddle pour revenir après paiement (sans slash final).

# --- SMTP local (Mailpit, inclus dans docker compose) ----------------------
# Tout e-mail transactionnel est réellement remis au captureur : aucune
# alerte ne part dans le vide. Interface : http://localhost:8025
# scripts/configure_local_smtp.sh applique ces valeurs sans toucher aux
# autres secrets.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@presence.local
SERVER_EMAIL=noreply@presence.local
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# --- SMTP cloud (Mailtrap) : remplacer le bloc ci-dessus en staging --------
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=<mailtrap-user>
# EMAIL_HOST_PASSWORD=<mailtrap-password>

# PostgreSQL
POSTGRES_DB=presence
POSTGRES_USER=presence
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AKA IA (AI Growth Advisor) -------------------------------------------
# Clé strictement serveur. Laisser vide désactive l'advisor ; ne jamais
# l'exposer dans le bundle frontend, un log ou un dépôt Git.
AKA_AI_BASE_URL=https://ai.elomaiapp.com
AKA_AI_API_KEY=replace-with-your-aka-ia-api-key
# Liste ordonnée : bascule sur le modèle suivant en cas d'échec persistant.
AKA_AI_MODELS=groq/qwen/qwen3.8-27b,ddgw/gpt-5.4-mini
AKA_AI_MAX_RETRIES=2
AKA_AI_CONNECT_TIMEOUT=3
AKA_AI_READ_TIMEOUT=45
AKA_AI_BACKOFF_BASE=2
AKA_AI_BACKOFF_MAX=60
AKA_AI_MAX_RETRY_AFTER=300
AKA_AI_TEMPERATURE=0.2
AKA_AI_MAX_TOKENS=900
AKA_AI_MAX_RESPONSE_BYTES=1000000
AKA_AI_CIRCUIT_FAILURE_THRESHOLD=5
AKA_AI_CIRCUIT_RECOVERY_SECONDS=300
AKA_AI_MAX_PROMPT_CHARS=60000
AI_ADVISOR_ENABLED=false
AI_ADVISOR_RETRY_MAX_SECONDS=900
# A run not touched for this long is considered abandoned by a dead worker.
AI_ADVISOR_STALE_RUN_SECONDS=600
# Stop calling the gateway for this long after it answers in guest mode.
AKA_AI_AUTH_FAILURE_COOLDOWN=900
# Scans without progress for these delays are failed by the periodic reaper.
SCAN_REAP_RUNNING_AFTER_SECONDS=900
SCAN_REAP_QUEUED_AFTER_SECONDS=900

# --- Paddle Billing --------------------------------------------------------
# Sandbox : https://sandbox-api.paddle.com + clés "pdl_sdbx_..."
# Live    : https://api.paddle.com + clés "pdl_live_..."
# Sans BILLING_ENABLED=true, PADDLE_API_KEY et des price_id en base,
# /subscriptions/checkout/ renvoie 503 — aucun plan payant n'est accordé.
BILLING_ENABLED=false
BILLING_PROVIDER=paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_ENVIRONMENT=sandbox
# Price IDs créés dans Paddle, mappés par `manage.py configure_billing`.
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=
PADDLE_PRICE_AGENCY_MONTHLY=
PADDLE_PRICE_AGENCY_YEARLY=

# --- Scanner sandbox (external tools: Lighthouse, testssl.sh, nmap, …) ----
# process = child process with CPU/RSS/time limits (default, no host deps).
# docker  = one-shot hardened container; requires the Docker CLI + socket on
#           the Celery worker and a pre-pulled image (never pulls at scan time).
SCANNER_SANDBOX_MODE=process
SCANNER_SANDBOX_MAX_TIMEOUT=300
SCANNER_SANDBOX_DEFAULT_MEMORY_MB=512
SCANNER_SANDBOX_MAX_CONCURRENCY=2
SCAN_TOTAL_TIME_BUDGET_SECONDS=540
# Optional Docker backend (SCANNER_SANDBOX_MODE=docker).
# The canonical compose stack overrides this with presence_scanner_sandbox,
# whose gateway enforces the anti-SSRF egress rules.  "bridge" is only a
# fallback for standalone workers.
SCANNER_SANDBOX_DOCKER_NETWORK=bridge
# Host path mounted identically into the worker and the Docker daemon.  ZAP
# writes its report there and the daemon bind-mounts it into /zap/wrk.  Leave
# empty when the worker runs directly on the Docker host.  In the compose
# stack: install -d -m 1777 /tmp/presence-scanner (the app user must own it).
SCANNER_SANDBOX_SHARED_WORK_DIR=
SCANNER_SANDBOX_DOCKER_CPUS=1.0
SCANNER_SANDBOX_DOCKER_PIDS=256
SCANNER_DOCKER_IMAGE_LIGHTHOUSE=
# Image carrying the six advanced tools (nmap, nikto, whatweb, testssl.sh,
# dnsrecon, gobuster).  Built by `docker compose build scanner-tools`; the tag
# is pinned so scheduled scans never run `latest`, and the sandbox never pulls
# during a scan (a missing image makes the scanner unavailable, not "failed").
SCANNER_TOOLS_IMAGE=presence-scanner-tools:2026-10-27
# Per-scanner override, left empty to use SCANNER_TOOLS_IMAGE above.  An empty
# value means "use the project image", never "this scanner is absent".
SCANNER_DOCKER_IMAGE_TESTSSL=
SCANNER_DOCKER_IMAGE_NMAP=
SCANNER_DOCKER_IMAGE_NIKTO=
SCANNER_DOCKER_IMAGE_WHATWEB=
SCANNER_DOCKER_IMAGE_DNSRECON=
SCANNER_DOCKER_IMAGE_GOBUSTER=
SCANNER_DOCKER_IMAGE_ZAP=zaproxy/zap-stable:latest
SCANNER_DOCKER_IMAGE_NUCLEI=projectdiscovery/nuclei:latest
# testssl.sh tests cipher categories plus protocols, certificate/server
# defaults, HSTS/headers and vulnerability probes, limited to the first DNS
# address (`--ip one`) so the full set fits 120 s: 65 s at rest and 100 s under
# four CPU burners on a Cloudflare-fronted target.  Scanning every address
# takes 140 s and would be killed; the whole-scan budget stays 540 s.
SCANNER_TIMEOUT_TESTSSL=120
SCANNER_TESTSSL_CPU_SECONDS=120
# Wordlist baked into the tools image (Debian dirb package).  Never taken from
# scan input; keep the whole enumeration bounded (4 614 paths by default).
SCANNER_GOBUSTER_WORDLIST=/usr/share/dirb/wordlists/common.txt
SCANNER_GOBUSTER_THREADS=10
# Host directory containing the nuclei-templates repository (required by
# the official image, which ships the binary only).
SCANNER_NUCLEI_TEMPLATES_PATH=/tmp/presence-scanner/nuclei-templates
SCANNER_NUCLEI_MEMORY_MB=1536
# Deployment-reported versions copied into archive metadata.  Leave empty if
# unknown: the archive records "unknown" rather than a guessed value.
SCANNER_NUCLEI_BINARY_VERSION=
SCANNER_NUCLEI_TEMPLATES_VERSION=
# standard = exposures/misconfigurations over HTTP, high/critical only,
# no intrusive templates, 150 s hard budget (safety margin under 180 s).
# thorough = the previous exposure/misconfig medium+ coverage, 178 s hard
# budget; manual/dedicated use only because its margin is thin.
# deep adds the full CVE tag selection and needs a dedicated worker with
# SCAN_TOTAL_TIME_BUDGET_SECONDS > 540 and SCANNER_SANDBOX_MAX_TIMEOUT raised
# above 300; it is never scheduled by default.  All profiles are bounded in
# config/settings/base.py.
SCANNER_NUCLEI_PROFILE=standard
SCANNER_TIMEOUT_NUCLEI_STANDARD=150
SCANNER_TIMEOUT_NUCLEI_THOROUGH=178
SCANNER_TIMEOUT_NUCLEI_DEEP=540

# --- Raw scanner report archives -----------------------------------------
# Private, redacted JSONL copies (including partial output from a timeout).
# Keep this outside MEDIA_ROOT and on a dedicated volume.  The canonical
# compose stack mounts scanner_archive_data at /app/scanner-archives.
SCANNER_ARCHIVE_ENABLED=true
SCANNER_ARCHIVE_DIR=/app/scanner-archives
SCANNER_ARCHIVE_MAX_BYTES=8388608
SCANNER_ARCHIVE_RETENTION_DAYS=30

# --- Advanced security tier (ZAP / Nuclei) --------------------------------
# STRICTLY opt-in: these tools send real attack payloads.  Keep false on the
# public production stack; enable only on a dedicated, authorized scan worker.
SCANNER_ADVANCED_SECURITY_ENABLED=false
# auto | docker | api  (docker = sandboxed official ZAP image)
SCANNER_ZAP_MODE=auto
# Absolute path inside the official zap-stable image (it is not on PATH).
SCANNER_ZAP_SCRIPT=/zap/zap-baseline.py
SCANNER_ZAP_ACTIVE_SCAN=false
SCANNER_TIMEOUT_ZAP=300
SCANNER_ZAP_MEMORY_MB=1536

# --- Lighthouse (performance + technical SEO) -----------------------------
SCANNER_TIMEOUT_LIGHTHOUSE=120
SCANNER_LIGHTHOUSE_CATEGORIES=performance,seo
SCANNER_LIGHTHOUSE_PRESET=desktop
SCANNER_LIGHTHOUSE_MEMORY_MB=2048
SCANNER_LIGHTHOUSE_PIN_TARGET_IP=true
# Optional egress proxy for Chromium (recommended on a VPS so the headless
# browser cannot reach internal ranges).
SCANNER_LIGHTHOUSE_CHROME_PROXY=

# Production-only settings
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# VAPID keys for Web Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:support@presence.local
