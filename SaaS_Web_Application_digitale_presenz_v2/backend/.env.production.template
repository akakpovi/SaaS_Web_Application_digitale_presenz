# =============================================================================
# Presence — template de configuration de PRODUCTION
# =============================================================================
# Copier ce fichier vers .env sur le serveur, remplacer tous les placeholders,
# puis restreindre les permissions : chmod 600 .env
#
# Ne jamais committer un .env réel. Les valeurs ci-dessous sont des exemples
# ou des placeholders volontairement non exploitables.
# =============================================================================

# === DJANGO CORE ===
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
DJANGO_SECRET_KEY=<GÉNÉRER: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
DJANGO_ALLOWED_HOSTS=<DOMAINE_PUBLIC>,www.<DOMAINE_PUBLIC>,<IP_VPS>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<DOMAINE_PUBLIC>,https://www.<DOMAINE_PUBLIC>
CORS_ALLOWED_ORIGINS=https://<DOMAINE_PUBLIC>,https://www.<DOMAINE_PUBLIC>
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# === FRONTEND ===
FRONTEND_URL=https://<DOMAINE_PUBLIC>
VITE_BASE_URL=https://<DOMAINE_PUBLIC>
VITE_WP_API_URL=/cms
PRERENDER_WP_API_URL=http://wordpress:80/wp-json

# === BASE DE DONNÉES ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=presence
POSTGRES_USER=<USER>
POSTGRES_PASSWORD=<MOT_DE_PASSE_FORT>

# === REDIS / CELERY ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === SCANNERS ===
SCANNER_SANDBOX_MODE=docker
SCANNER_SANDBOX_DOCKER_NETWORK=presence_scanner_sandbox
SCANNER_SANDBOX_SHARED_WORK_DIR=/var/lib/presence-scanner-work
SCANNER_TOOLS_IMAGE=presence-scanner-tools:2026-10-27
SCANNER_DOCKER_IMAGE_NUCLEI=presence-nuclei:2026-11-07
# Épingler une version/digest ZAP ; ne pas utiliser :latest en production.
SCANNER_DOCKER_IMAGE_ZAP=zaproxy/zap-stable:<TAG_ÉPINGLÉ>
SCANNER_ADVANCED_SECURITY_ENABLED=true
# Optionnel : UID/GID du socket Docker sur l'hôte, si différent de 984.
# DOCKER_GID=984

# === PAIEMENT PADDLE ===
BILLING_ENABLED=true
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=production
PADDLE_API_URL=https://api.paddle.com
PADDLE_API_KEY=<CLÉ_API_PADDLE_PRODUCTION>
PADDLE_WEBHOOK_SECRET=<SECRET_WEBHOOK_PADDLE>
PADDLE_PRICE_PRO_MONTHLY=<PRICE_ID>
PADDLE_PRICE_PRO_YEARLY=<PRICE_ID>
PADDLE_PRICE_BUSINESS_MONTHLY=<PRICE_ID>
PADDLE_PRICE_BUSINESS_YEARLY=<PRICE_ID>
PADDLE_PRICE_AGENCY_MONTHLY=<PRICE_ID>
PADDLE_PRICE_AGENCY_YEARLY=<PRICE_ID>

# === EMAIL SMTP ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<HÔTE_SMTP>
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=<USER_SMTP>
EMAIL_HOST_PASSWORD=<MOT_DE_PASSE_SMTP>
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@<DOMAINE_PUBLIC>
SERVER_EMAIL=noreply@<DOMAINE_PUBLIC>

# === OAUTH LINKEDIN ===
LINKEDIN_CLIENT_ID=<CLIENT_ID>
LINKEDIN_CLIENT_SECRET=<CLIENT_SECRET>
LINKEDIN_REDIRECT_URI=https://<DOMAINE_PUBLIC>/api/v1/social/oauth/linkedin/callback/
LINKEDIN_OAUTH_REVOKE_URL=https://www.linkedin.com/oauth/v2/revoke
LINKEDIN_OAUTH_SCOPES=openid profile w_member_social
LINKEDIN_OAUTH_TIMEOUT=10

# === CONNECTEURS SOCIAUX — CHIFFREMENT ===
# Générer avec : openssl rand -base64 32
CONNECTOR_KEK_V1=<CLÉ_32_OCTETS_BASE64>
CONNECTOR_KEK_ACTIVE_VERSION=1

# === IA (optionnel) ===
AI_ADVISOR_ENABLED=false
AKA_AI_ENABLED=false
AKA_AI_BASE_URL=https://ai.elomaiapp.com
AKA_AI_API_KEY=<CLÉ_AKA>
AKA_AI_MODELS=groq/qwen/qwen3.8-27b,ddgw/gpt-5.4-mini
